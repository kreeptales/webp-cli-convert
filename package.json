{
  "name": "webp-cli-convert",
  "version": "2.0.0",
  "description": "Zero-fuss CLI to convert images (JPG, PNG, GIF, TIFF, AVIF, BMP) to WebP, with an interactive folder browser and options wizard",
  "type": "module",
  "bin": {
    "webp-cli-convert": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "webp",
    "image",
    "converter",
    "cli",
    "sharp",
    "jpg",
    "png",
    "compress",
    "interactive",
    "batch"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreeptales/webp-cli-convert.git"
  },
  "bugs": {
    "url": "https://github.com/kreeptales/webp-cli-convert/issues"
  },
  "homepage": "https://github.com/kreeptales/webp-cli-convert#readme",
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
